+fn project_layer(project_dir: &std::path::Path, config: &str) -> ConfigLayerEntry {
+    ConfigLayerEntry::new(
+        ConfigLayerSource::Project {
+            dot_codex_folder: project_dir.join(".codex").abs(),
+        },
+        toml::from_str(config).expect("valid project config"),
+    )
+}
+
+fn skill_rules(layers: Vec<ConfigLayerEntry>) -> SkillConfigRules {
+    let stack = ConfigLayerStack::new(
+        layers,
+        Default::default(),
+        ConfigRequirementsToml::default(),
+    )
+    .expect("valid config stack");
+    skill_config_rules_from_stack(&stack)
+}
+
+#[test]
+fn project_rule_disables_selected_path() {
+    let root = TempDir::new().expect("temp dir");
+    let target = PathUri::from_abs_path(&root.path().join("skills/target/SKILL.md").abs());
+    let rules = skill_rules(vec![project_layer(
+        root.path(),
+        &path_toggle_config(&root.path().join("skills/target/SKILL.md"), false),
+    )]);
+
+    assert_eq!(
+        rules.resolve_disabled_paths([("target", &target)]),
+        [target].into_iter().collect()
+    );
+}
+
+#[test]
+fn project_name_rule_reenables_user_disabled_path() {
+    let root = TempDir::new().expect("temp dir");
+    let target_path = root.path().join("skills/target/SKILL.md");
+    let target = PathUri::from_abs_path(&target_path.abs());
+    let user_only = skill_rules(vec![user_layer(
+        &root,
+        &path_toggle_config(&target_path, false),
+    )]);
+    let rules = skill_rules(vec![
+        user_layer(&root, &path_toggle_config(&target_path, false)),
+        project_layer(
+            root.path(),
+            "[[skills.config]]\nname = 'target'\nenabled = true\n",
+        ),
+    ]);
+
+    assert_eq!(
+        user_only.resolve_disabled_paths([("target", &target)]),
+        [target.clone()].into_iter().collect()
+    );
+    assert_eq!(
+        rules.resolve_disabled_paths([("target", &target)]),
+        Default::default()
+    );
+}
+
+#[test]
+fn project_rule_removal_restores_user_rule_and_preserves_unrelated_rules() {
+    let root = TempDir::new().expect("temp dir");
+    let target_path = root.path().join("skills/target/SKILL.md");
+    let inherited_path = root.path().join("skills/inherited/SKILL.md");
+    let unrelated_path = root.path().join("skills/unrelated/SKILL.md");
+    let target = PathUri::from_abs_path(&target_path.abs());
+    let inherited = PathUri::from_abs_path(&inherited_path.abs());
+    let unrelated = PathUri::from_abs_path(&unrelated_path.abs());
+    let user =
+        path_toggle_config(&target_path, false) + &path_toggle_config(&inherited_path, false);
+    let retained = path_toggle_config(&unrelated_path, false);
+    let before = skill_rules(vec![
+        user_layer(&root, &user),
+        project_layer(
+            root.path(),
+            &(retained.clone() + &path_toggle_config(&target_path, true)),
+        ),
+    ]);
+    let after = skill_rules(vec![
+        user_layer(&root, &user),
+        project_layer(root.path(), &retained),
+    ]);
+    let skills = [
+        ("target", &target),
+        ("inherited", &inherited),
+        ("unrelated", &unrelated),
+    ];
+
+    assert_eq!(
+        before.resolve_disabled_paths(skills),
+        [inherited.clone(), unrelated.clone()].into_iter().collect()
+    );
+    assert_eq!(
+        after.resolve_disabled_paths(skills),
+        [target, inherited, unrelated].into_iter().collect()
+    );
+}

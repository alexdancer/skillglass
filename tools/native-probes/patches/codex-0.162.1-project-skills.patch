+#[test]
+fn disabled_project_rules_cannot_change_user_rules() {
+    let root = TempDir::new().expect("temp dir");
+    let denied_path = root.path().join("skills/denied/SKILL.md");
+    let allowed_path = root.path().join("skills/allowed/SKILL.md");
+    let denied = PathUri::from_abs_path(&denied_path.abs());
+    let allowed = PathUri::from_abs_path(&allowed_path.abs());
+    let project = ConfigLayerEntry::new_disabled(
+        ConfigLayerSource::Project {
+            dot_codex_folder: root.path().join(".codex").abs(),
+        },
+        toml::from_str::<toml::Value>(
+            &(path_toggle_config(&denied_path, true) + &path_toggle_config(&allowed_path, false)),
+        )
+        .expect("valid project config"),
+        "project is untrusted",
+    );
+    let rules = skill_rules(vec![
+        user_layer(&root, &path_toggle_config(&denied_path, false)),
+        project,
+    ]);
+
+    assert_eq!(
+        rules.resolve_disabled_paths([("denied", &denied), ("allowed", &allowed)]),
+        [denied].into_iter().collect()
+    );
+}
